# E-Masjid Backend — Environment Variables (template — no real secrets)
# Copy this file to `.env` and fill in real values.

NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://user:password@cluster.example.net/emasjid?retryWrites=true&w=majority

# JWT_SECRET: minimum 48 bytes of randomness, base64url encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotate every 90 days OR immediately after any suspected compromise.
# Rotation procedure:
#   1. Generate a new value with the command above.
#   2. Set JWT_SECRET_OLD to the previous value in the same .env file
#      (this lets in-flight tokens keep validating during the rollout window).
#   3. Set JWT_SECRET to the new value and restart the server.
#   4. After JWT_EXPIRE passes for the last token issued under the old secret,
#      remove JWT_SECRET_OLD and restart once more.
JWT_SECRET=change_me_to_a_long_random_string
JWT_SECRET_OLD=
JWT_EXPIRE=8h

CLIENT_URL=http://localhost:5173

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# EMAIL PROVIDER
# Set to "resend" to use Resend (recommended for production).
# Set to "smtp" to use a generic SMTP relay (e.g., Gmail, Zoho, Mailgun SMTP).
EMAIL_PROVIDER=resend

# --- Resend (https://resend.com) ---
# 1. Sign up at resend.com and verify your email.
# 2. Create an API key under "API Keys". Paste it below.
# 3. Until you verify a custom domain, emails are sent from
#    onresend@resend.dev — fine for testing, replace once you own a domain.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onresend@resend.dev
EMAIL_FROM_NAME=E-Masjid System

# --- Generic SMTP (used only when EMAIL_PROVIDER=smtp) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
