              "pm.test('Saved to Al-Rahman', () => pm.expect(pm.response.json().data.mosqueId).to.eql(pm.collectionVariables.get('rahmanId')));",
              "pm.collectionVariables.set('createdEventId', pm.response.json().data._id);"
            ]
          }
        }
      ]
    },

