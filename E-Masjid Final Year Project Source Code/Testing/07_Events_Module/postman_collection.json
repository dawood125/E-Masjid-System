          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('adminToken', pm.response.json().token);",
              "console.log('admin (Al-Noor) token saved');"
            ]
          }
        }
      ]
    },
    {
      "name": "0. Setup - Login as admin2 (Al-Rahman)",
      "request": {
        "method": "POST",
