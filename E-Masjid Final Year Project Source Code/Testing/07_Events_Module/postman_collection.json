{
  "info": {
    "name": "E-Masjid Phase 7 - Events Module Scope Tests",
    "description": "Cross-mosque authorization tests for /api/events endpoints. Run the four auth requests first (they populate collection variables), then run any scope test. Each request shows the expected HTTP status + meaning in the title.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup - Fetch masjid IDs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/mosques/public",
          "host": ["{{baseUrl}}"],
          "path": ["api", "mosques", "public"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "const noor = (data.data || []).find(m => m.name === 'Masjid Al-Noor');",
              "const rahman = (data.data || []).find(m => m.name === 'Masjid Al-Rahman');",
              "if (noor) pm.collectionVariables.set('noorId', noor._id);",
              "if (rahman) pm.collectionVariables.set('rahmanId', rahman._id);",
              "pm.collectionVariables.set('unmanagedMosqueId', '5f4f4f4f4f4f4f4f4f4f4f4f');",
              "console.log('Noor:', pm.collectionVariables.get('noorId'));",
              "console.log('Rahman:', pm.collectionVariables.get('rahmanId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "0. Setup - Login as manager (manager@emasjid.pk)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"manager@emasjid.pk\",\"password\":\"manager123\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('managerToken', pm.response.json().token);",
              "console.log('manager token saved');"
            ]
          }
        }
      ]
    },
    {
      "name": "0. Setup - Login as admin (Al-Noor)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@emasjid.pk\",\"password\":\"admin123\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
