            ]
          }
        }
      ]
    },

    {
      "name": "5. manager GET /api/events/admin - expect 200, events from all 4 managed masjids",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/events/admin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events", "admin"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.expect(pm.response.code).to.eql(200));",
              "const list = pm.response.json().data || [];",
              "pm.test('Has events', () => pm.expect(list.length).to.be.greaterThan(0));",
              "const ids = new Set(list.map(e => e.mosqueId));",
              "pm.test('Events span at least 2 masjids', () => pm.expect(ids.size).to.be.at.least(2));"
            ]
          }
        }
      ]
    },

    {
