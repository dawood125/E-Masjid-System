          }
        }
      ]
    },

    {
      "name": "1. Public GET /api/events - no auth - expect 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Public endpoint returns 200', () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test('Response has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },

    {
      "name": "2. GET /api/events/admin (no auth) - expect 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events/admin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events", "admin"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Protected endpoint rejects anonymous', () => pm.expect(pm.response.code).to.eql(401));"
            ]
          }
        }
      ]
    },

    {
      "name": "3. admin (Al-Noor) GET /api/events/admin - expect 200, only Noor",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/events/admin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events", "admin"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.expect(pm.response.code).to.eql(200));",
              "const list = pm.response.json().data || [];",
              "pm.test('Has events', () => pm.expect(list.length).to.be.greaterThan(0));",
              "pm.test('All events belong to Al-Noor', () => pm.expect(list.every(e => e.mosqueId === pm.collectionVariables.get('noorId'))).to.be.true);"
            ]
          }
        }
      ]
    },

